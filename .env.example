# Example only. Keep real credentials in .env.local, which is ignored by Git.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
# Required only with --provider openai/auto when OPENAI_API_KEY is present.
BMW_PM_OPENAI_MODEL=

# Optional: enables bounded inspection of public pages cited by web research.
# Put a real key in Git-ignored .env.local or the server environment.
FIRECRAWL_API_KEY=

# Shared Supabase database: Connect > URI > Session pooler (port 5432).
# Fill in the actual values without brackets; URL-encode reserved password characters.
# DATABASE_URL="postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require"
DATABASE_URL=

# Optional explicit local database (used when DATABASE_URL is empty).
# BMW_PM_DB_PATH=data/processed/bmw_pm.db
