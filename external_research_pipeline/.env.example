# Copy to .env inside this folder and fill in. .env is gitignored.
# cp .env.example .env

# --- Firecrawl (required) -------------------------------------------------- #
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- LLM extraction: pick ONE provider ------------------------------------- #
# Only the selected provider's key is needed. Leave the other blank.
LLM_PROVIDER=openai

# used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# used when LLM_PROVIDER=anthropic
# leave ANTHROPIC_MODEL blank to default to claude-opus-5;
# claude-haiku-4-5 is the cheaper choice for bulk extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Rate limiting (free tier) --------------------------------------------- #
# Seconds to leave between Firecrawl requests, searches and scrapes alike.
# The free tier limits requests per minute; 2s is deliberately conservative.
# Set to 0 to disable throttling on a paid plan.
FIRECRAWL_SEARCH_DELAY_SECONDS=2
# Total attempts per Firecrawl request, so 4 means up to 3 retries. A 429 that
# carries Retry-After is honoured exactly; otherwise exponential backoff.
FIRECRAWL_MAX_RETRIES=4

# --- Budget and request shaping -------------------------------------------- #
# Results requested per search query (search costs ~2 credits per 10 results).
SEARCH_LIMIT=5
# Hard cap on pages handled per run (each uncached page costs 1 credit).
MAX_PAGES_PER_RUN=20
# Max characters of page text per LLM request; longer pages are chunked.
MAX_CONTENT_CHARS=15000
