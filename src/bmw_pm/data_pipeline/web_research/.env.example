# Copy to .env inside this folder and fill in. .env is gitignored.
# cp .env.example .env

# --- Firecrawl (required) -------------------------------------------------- #
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- LLM extraction: pick ONE provider ------------------------------------- #
# Only the selected provider's key is needed. Leave the other blank.
LLM_PROVIDER=openai

# used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# used when LLM_PROVIDER=anthropic
# leave ANTHROPIC_MODEL blank to default to claude-opus-5;
# claude-haiku-4-5 is the cheaper choice for bulk extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Rate limiting (free tier) --------------------------------------------- #
# Seconds to leave between Firecrawl requests, searches and scrapes alike.
# The free tier limits requests per minute; 2s is deliberately conservative.
# Set to 0 to disable throttling on a paid plan.
FIRECRAWL_SEARCH_DELAY_SECONDS=2
# Total attempts per Firecrawl request, so 4 means up to 3 retries. A 429 that
# carries Retry-After is honoured exactly; otherwise exponential backoff.
FIRECRAWL_MAX_RETRIES=4

# --- Budget and request shaping -------------------------------------------- #
# Results requested per search query (search costs ~2 credits per 10 results).
SEARCH_LIMIT=5
# Hard cap on pages handled per run (each uncached page costs 1 credit).
MAX_PAGES_PER_RUN=20

# --- Evidence yield per scraped page --------------------------------------- #
# Characters of page text per extraction request. Keep this well below the
# model's output ceiling: too large a chunk makes the model emit more records
# than fit in one response, which truncates the JSON and loses the chunk.
EXTRACTION_CHUNK_CHARS=7000
# Characters shared between consecutive chunks, so a claim on a boundary is
# visible in full to at least one request.
EXTRACTION_CHUNK_OVERLAP_CHARS=600
# Below this much usable text a page is skipped without an LLM call: it is
# almost always a cookie wall, a JS shell or an error page.
MIN_CONTENT_CHARS=1000
# Post-scrape relevance gate. A page passes on either count.
MIN_TOPIC_HITS=3
MIN_VEHICLE_HITS=2

# --- Semantic quality ------------------------------------------------------ #
# Claim-similarity threshold for two claims from the SAME page. Lower than the
# cross-source figure because same page + same subtopic is a stronger prior.
# SAME_PAGE_DUPLICATE_THRESHOLD is set in config.py (default 88).
# Fraction of the shorter evidence span that must overlap before two same-page
# records count as one proposition - the language-independent dedup backstop.
# SPAN_OVERLAP_RATIO is set in config.py (default 0.6).
# Numeric units are canonicalized (Min./Minuten -> minutes, % -> percent).
# A bare kWh becomes kWh/100 km only when the quote or page proves consumption
# and the figure is <= CONSUMPTION_MAX_KWH (40) - a battery capacity is never
# rewritten. Out-of-scope records (taxation, financing, insurance, incentives)
# are dropped and counted as records_filtered_out_of_scope.

# MAX_CONTENT_CHARS is the former name of EXTRACTION_CHUNK_CHARS. It is still
# read if set, but a value above 10000 is clamped to EXTRACTION_CHUNK_CHARS's
# default and a warning is logged - its old default of 15000 would otherwise
# silently restore the oversized chunking that truncates the model's response.
# Delete the line rather than leaving it.
# MAX_CONTENT_CHARS=15000
